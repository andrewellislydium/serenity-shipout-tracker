# Copy to .env for local development. On Azure these are App Service application settings.
PORT=5190
STORE=file
# DATA_DIR=./data
# Passcodes: at least 16 random characters each. Editor can change things, viewer can only read.
EDITOR_TOKEN=change-me-editor-passcode
VIEWER_TOKEN=change-me-viewer-passcode
# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me

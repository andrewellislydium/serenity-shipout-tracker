# Copy to .env for local development. On Azure these are App Service application settings
# (Environment variables), not a file. Settings already in the environment win over this file.
PORT=5190

# Storage: file (local JSON file in DATA_DIR) or table (Azure Table Storage).
STORE=file
# DATA_DIR=./data

# STORE=table in Azure: the storage account name. The web app's managed identity signs in, no key needed.
# STORAGE_ACCOUNT=serenitytracker
# STORE=table locally against the Azurite emulator instead:
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Passcodes: at least 16 random characters each. Editor can change things, viewer can only read.
EDITOR_TOKEN=change-me-editor-passcode
VIEWER_TOKEN=change-me-viewer-passcode
# 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me
